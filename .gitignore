node_modules/
dist/
# Vercel adapter build output. `astro build` writes the served static files and
# the serverless function here, so it appears in every `git status` and is one
# stray `git add -A` away from being committed.
.vercel/
.astro/
.env
.DS_Store

# Source carousel art (228 MB of PNG/PDF). Kept locally, not in git —
# GitHub rejects files over 100 MB and this would bloat the repo permanently.
Vantage Content/

# Reference/source files (logo draft PNG, Mont font source zip) — the built
# assets they produced already live in the repo (public/fonts, favicon.svg).
Vantage Assets/
