---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  image?: string;
  // Set on production surfaces that are not reader destinations — currently
  // just /panels/<slug>, which renders an explainer at social-panel size for
  // export. Those pages would otherwise offer search engines a second, worse
  // copy of the article.
  noindex?: boolean;
}
const {
  title,
  description = "Vantage — explained, not spun.",
  image,
  noindex = false,
} = Astro.props;

const fullTitle = `${title} · Vantage`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site) : undefined;
---
<!doctype html>
{/*
  data-theme is server-rendered as "light" so a reader with JavaScript off gets
  a complete, correct page rather than an unstyled one. The boot script in
  <head> upgrades it to the stored or system preference before first paint.
*/}
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{fullTitle}</title>
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vantage" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {ogImage && <meta property="og:image" content={ogImage} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <!-- Mont is self-hosted and carries the wordmark, which is above the fold,
         so it is preloaded rather than discovered via the stylesheet. -->
    <link
      rel="preload"
      href="/fonts/Mont-Heavy.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/*
      Theme boot. This has to be inline and in <head>, before any markup paints:
      the pages are prerendered as light, so a stored dark preference applied
      any later than this flashes a cream page at a reader who asked for dark.

      is:inline keeps it out of Vite's module graph so it stays a plain blocking
      script rather than a deferred module.
    */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('vantage-theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (err) {
          /* Private mode can throw on localStorage. Light is the default. */
        }
      })();
    </script>
  </head>
  <body class="bg-ground text-content font-body antialiased flex flex-col min-h-screen">
    <div class="flex-1">
      <slot />
    </div>
    <Footer />
    <!-- Vercel Web Analytics. Reports the route pattern (not the raw path) for
         dynamic routes, so /explained/<slug> aggregates correctly. Requires
         Web Analytics to be enabled in the Vercel project dashboard. -->
    <Analytics />
  </body>
</html>
