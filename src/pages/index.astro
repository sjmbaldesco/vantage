---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ExplainerCard from '../components/ExplainerCard.astro';
import { getCollection } from 'astro:content';
import { sortExplainers } from '../utils';

// The home page is the latest explainers only — /archive ("Articles" in the
// nav) is the complete run. Without this cap the two pages would be the same
// list.
//
// This reads from `explainers`, not `posts`. The posts collection still exists
// for short single-fact items, but Vantage publishes long-form explainers and
// nothing else right now, so pointing the feed at posts left it empty.
const LATEST_COUNT = 6;

const allExplainers = sortExplainers(await getCollection('explainers'));
const explainers = allExplainers.slice(0, LATEST_COUNT);
const hasMore = allExplainers.length > explainers.length;
---
<Layout title="Feed">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-3">Latest</p>
    <p class="text-lg leading-relaxed text-paper/70 mb-8 max-w-xl">
      Vantage explains the story behind the headline — one fact at a time.
    </p>

    <div class="grid gap-4">
      {explainers.map((entry) => (
        <ExplainerCard
          slug={entry.id}
          category={entry.data.category}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          publishedAt={entry.data.publishedAt}
        />
      ))}
    </div>

    <div class="border-t border-paper/10 mt-10 pt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href="/archive" class="font-medium text-teal-light hover:text-paper transition-colors">
        {hasMore ? 'See all articles →' : 'Browse the archive →'}
      </a>
      <a href="/explained" class="font-medium text-teal-light hover:text-paper transition-colors">
        Read the long-form explainers →
      </a>
    </div>
  </main>
</Layout>
