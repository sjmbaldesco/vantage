---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ExplainerCard from '../components/ExplainerCard.astro';
import { getCollection } from 'astro:content';
import { sortExplainers } from '../utils';

// The home page is the latest explainers only — /archive ("Articles" in the
// nav) is the complete run. Without this cap the two pages would be the same
// list.
//
// This reads from `explainers`, not `posts`. The posts collection still exists
// for short single-fact items, but Vantage publishes long-form explainers and
// nothing else right now, so pointing the feed at posts left it empty.
const LATEST_COUNT = 6;

const allExplainers = sortExplainers(await getCollection('explainers'));
const explainers = allExplainers.slice(0, LATEST_COUNT);
---
<Layout title="Feed">
  <Header />
  <main class="max-w-5xl mx-auto px-6 py-12 sm:py-16">
    {/*
      "Latest" is now the page's only heading — the standfirst under it and the
      two links under the grid were both removed as clutter, so this carries
      the page on its own and is set as a display heading rather than the
      small teal eyebrow it used to be. The teal moved to the rule beneath it
      so the accent survives the promotion.
    */}
    <h1 class="text-3xl sm:text-4xl font-display font-bold text-paper leading-none">Latest</h1>
    <div class="h-[3px] w-14 bg-teal mt-3 mb-8"></div>

    <div class="grid gap-4 sm:grid-cols-2">
      {explainers.map((entry) => (
        <ExplainerCard
          slug={entry.id}
          category={entry.data.category}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          publishedAt={entry.data.publishedAt}
        />
      ))}
    </div>
  </main>
</Layout>
