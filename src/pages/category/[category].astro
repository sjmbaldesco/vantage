---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ExplainerCard from '../../components/ExplainerCard.astro';
import { getCollection } from 'astro:content';
import { categorySlug, sortExplainers } from '../../utils';
import type { GetStaticPaths } from 'astro';

// Routes are generated from the categories explainers actually carry, so a new
// category appears simply by authoring an entry with it — no route list to
// keep in sync.
export const getStaticPaths: GetStaticPaths = async () => {
  const explainers = await getCollection('explainers');
  const categories = [...new Set(explainers.map((e) => e.data.category))];

  return categories.map((category) => ({
    params: { category: categorySlug(category) },
    props: {
      category,
      entries: sortExplainers(
        explainers.filter((e) => e.data.category === category)
      ),
    },
  }));
};

const { category, entries } = Astro.props;
---
<Layout
  title={category}
  description={`Vantage articles filed under ${category}.`}
>
  <Header />
  <main class="max-w-5xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-3">Category</p>
    <h1 class="text-3xl sm:text-4xl font-display font-bold text-paper leading-tight mb-4">
      {category}
    </h1>
    <p class="text-lg leading-relaxed text-paper/70 mb-8 max-w-xl">
      {entries.length} {entries.length === 1 ? 'article' : 'articles'} filed under {category}.{" "}
      <a href="/archive" class="text-teal-light underline underline-offset-2 hover:text-paper transition-colors">See the full archive</a>.
    </p>

    <div class="grid gap-4 sm:grid-cols-2">
      {entries.map((entry) => (
        <ExplainerCard
          slug={entry.id}
          category={entry.data.category}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          publishedAt={entry.data.publishedAt}
        />
      ))}
    </div>
  </main>
</Layout>
