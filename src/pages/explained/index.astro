---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ExplainerCard from '../../components/ExplainerCard.astro';
import { getCollection } from 'astro:content';
import { sortExplainers } from '../../utils';

const explainers = sortExplainers(await getCollection('explainers'));
---
<Layout title="Explained" description="In-depth explainers on the stories that matter.">
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-3">Explained</p>
    <h1 class="text-3xl sm:text-4xl font-display font-bold text-paper leading-tight mb-4">
      The long-form explainers
    </h1>
    <p class="text-lg leading-relaxed text-paper/70 mb-4 max-w-xl">
      The stories behind the feed — each one walks through what's happening and why it matters.
    </p>
    <p class="text-sm text-paper/50 mb-8">
      Looking for something shorter? Browse the{" "}
      <a href="/" class="text-teal-light underline underline-offset-2 hover:text-paper transition-colors">feed</a>{" "}
      or the{" "}
      <a href="/archive" class="text-teal-light underline underline-offset-2 hover:text-paper transition-colors">full archive</a>.
    </p>

    <div class="grid gap-4">
      {explainers.map((entry) => (
        <ExplainerCard
          slug={entry.id}
          category={entry.data.category}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          publishedAt={entry.data.publishedAt}
        />
      ))}
    </div>
  </main>
</Layout>
