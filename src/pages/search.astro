---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---
<Layout title="Search" description="Search everything Vantage has published.">
  <Header />
  <main class="max-w-5xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-3">Search</p>
    <h1 class="text-3xl sm:text-4xl font-display font-bold text-paper leading-tight mb-4">
      Find a story
    </h1>
    <p class="text-lg leading-relaxed text-paper/70 mb-8 max-w-xl">
      Search runs entirely in your browser against a prebuilt index — nothing you
      type is sent to a server.
    </p>

    <label for="search-input" class="sr-only">Search Vantage</label>
    <input
      id="search-input"
      type="search"
      autocomplete="off"
      placeholder="Search posts and explainers…"
      class="w-full max-w-2xl bg-ink border border-paper/15 rounded-xl px-4 py-3 text-paper placeholder:text-paper/40 focus:border-teal focus:outline-none transition-colors"
    />

    <p id="search-status" class="text-sm text-paper/50 mt-4" aria-live="polite"></p>
    <div id="search-results" class="grid gap-4 sm:grid-cols-2 mt-6"></div>
  </main>
</Layout>

<style is:global>
  /* Pagefind marks each match with <mark>. Deliberately NOT styled like the
     brand's one-highlight-per-post device — that signal has to stay rare and
     mean one thing. Search hits get a quieter underline treatment instead. */
  #search-results mark {
    background: transparent;
    color: var(--color-teal-light);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

{/*
  is:inline keeps this script out of Vite's module graph entirely. Without it,
  Vite rewrites the dynamic import below and emits an unreplaced preload token,
  which throws before Pagefind can load.
*/}
<script is:inline>
  (function () {
    var input = document.getElementById('search-input');
    var status = document.getElementById('search-status');
    var results = document.getElementById('search-results');
    if (!input || !status || !results) return;

    var pagefind = null;
    var loadFailed = false;

    async function ensurePagefind() {
      if (pagefind || loadFailed) return pagefind;
      try {
        // Generated by `pagefind --site dist` during `npm run build`, so this
        // does not exist under `astro dev` — the catch below handles that.
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
      } catch (err) {
        loadFailed = true;
        status.textContent =
          'Search index unavailable. It is generated at build time — run `npm run build`, then `npm run preview`.';
      }
      return pagefind;
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function render(items) {
      results.innerHTML = items
        .map(function (item) {
          // Titles come from indexed page content, so escape them. Excerpts are
          // Pagefind-generated HTML containing only <mark>, inserted as-is.
          var title = escapeHtml((item.meta && item.meta.title) || item.url);
          var url = encodeURI(item.url);
          return (
            '<a href="' + url + '" class="block bg-ink border border-paper/15 rounded-xl p-5 hover:border-teal transition-colors">' +
            '<h2 class="text-lg font-display font-bold text-paper leading-tight mb-2">' + title + '</h2>' +
            '<p class="text-sm leading-relaxed text-paper/60">' + item.excerpt + '</p>' +
            '</a>'
          );
        })
        .join('');
    }

    async function run(query) {
      var trimmed = query.trim();
      if (!trimmed) {
        results.innerHTML = '';
        status.textContent = '';
        return;
      }

      var pf = await ensurePagefind();
      if (!pf) return;

      status.textContent = 'Searching…';
      var search = await pf.search(trimmed);
      var items = await Promise.all(
        search.results.slice(0, 20).map(function (r) { return r.data(); })
      );

      if (items.length === 0) {
        results.innerHTML = '';
        status.textContent = 'No results for “' + trimmed + '”.';
        return;
      }

      status.textContent =
        items.length + ' result' + (items.length === 1 ? '' : 's') + ' for “' + trimmed + '”.';
      render(items);
    }

    var debounce;
    input.addEventListener('input', function () {
      clearTimeout(debounce);
      debounce = setTimeout(function () { run(input.value); }, 180);
    });

    // Support deep links like /search?q=rice
    var initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
  })();
</script>
