---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { CONTACT_EMAIL } from '../consts';

// The suggestion chips are real titles from the published run, not invented
// example queries — a chip that returns nothing teaches a reader the search is
// broken. Four is enough to show the shape of the thing without becoming a
// second index.
const explainers = await getCollection('explainers');
const suggestions = explainers.slice(0, 4).map((entry) => entry.data.title);
const publishedCount = explainers.length;
---
<Layout title="Search" description="Search everything Vantage has published.">
  <Header />
  <main class="max-w-[840px] mx-auto px-6 sm:px-10 py-11">
    <p class="text-[11px] font-semibold text-accent uppercase tracking-[0.09em] mb-3">Search</p>
    <h1 class="text-4xl sm:text-[46px] font-display font-bold text-content leading-[1.02] tracking-[-0.02em] mb-3.5">
      Find a story
    </h1>
    <div class="h-[3px] w-14 bg-teal mb-6"></div>
    <p class="text-lg leading-relaxed text-content/70 mb-7 max-w-xl">
      Search runs entirely in your browser against a prebuilt index — nothing you
      type is sent to a server.
    </p>

    <div class="relative mb-4.5">
      <svg
        class="absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none text-teal"
        width="18" height="18" viewBox="0 0 24 24" fill="none"
        stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7" />
        <line x1="16.5" y1="16.5" x2="21" y2="21" />
      </svg>
      <label for="search-input" class="sr-only">Search Vantage</label>
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        placeholder="Search posts and explainers…"
        class="w-full bg-surface border border-content/12 rounded-xl pl-12 pr-4 py-3.5 text-[17px] text-content placeholder:text-content/40 focus:border-teal focus:outline-none transition-colors"
      />
    </div>

    {/* Idle state. Replaced by results the moment anything is typed, and
        restored when the box is cleared. */}
    <div id="search-idle" class="mt-6" data-pagefind-ignore>
      <p class="text-[10.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-2.5">Try</p>
      <div class="flex flex-wrap gap-2">
        {suggestions.map((suggestion) => (
          <button
            type="button"
            data-suggestion={suggestion}
            class="text-[12.5px] text-accent bg-surface border border-content/12 rounded-full px-3.5 py-1.5 cursor-pointer hover:border-teal transition-colors"
          >{suggestion}</button>
        ))}
      </div>
    </div>

    {/* Category chips, built from the counts Pagefind returns for the current
        query rather than from the site's full category list — a filter for a
        category with no matches is a dead control. */}
    <div id="search-filters" class="flex flex-wrap items-center gap-2.5 mt-6 empty:hidden"></div>

    <p id="search-status" class="text-sm text-content/50 mt-4" aria-live="polite"></p>
    <div id="search-results" class="flex flex-col gap-3 mt-4"></div>

    <div id="search-empty" class="hidden bg-surface border border-dashed border-content/20 rounded-xl p-8 mt-4">
      <p class="text-[19px] font-display font-bold text-content mb-1.5">Nothing yet on that</p>
      <p class="text-sm leading-relaxed text-content/65 mb-4 max-w-[480px]">
        {publishedCount} {publishedCount === 1 ? 'explainer is' : 'explainers are'} published so far.
        If this is something you want covered, say so — reader questions shape what comes next.
      </p>
      <a
        href={`mailto:${CONTACT_EMAIL}`}
        class="inline-block bg-accent text-ground rounded-[10px] px-[18px] py-2.5 text-sm font-medium no-underline transition-transform duration-200 hover:-translate-y-0.5"
      >Suggest a story →</a>
    </div>
  </main>
</Layout>

<style is:global>
  /* Pagefind marks each match with <mark>. Deliberately NOT styled like the
     brand's one-highlight-per-post device — that signal has to stay rare and
     mean one thing. Search hits get a quieter underline treatment instead. */
  #search-results mark {
    background: transparent;
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

{/*
  is:inline keeps this script out of Vite's module graph entirely. Without it,
  Vite rewrites the dynamic import below and emits an unreplaced preload token,
  which throws before Pagefind can load.
*/}
<script is:inline>
  (function () {
    var input = document.getElementById('search-input');
    var status = document.getElementById('search-status');
    var results = document.getElementById('search-results');
    var filters = document.getElementById('search-filters');
    var idle = document.getElementById('search-idle');
    var empty = document.getElementById('search-empty');
    if (!input || !status || !results || !filters || !idle || !empty) return;

    var pagefind = null;
    var loadFailed = false;
    var activeCategory = null;
    var lastQuery = '';

    async function ensurePagefind() {
      if (pagefind || loadFailed) return pagefind;
      try {
        // Generated by `pagefind --site .vercel/output/static` during
        // `npm run build`, so this does not exist under `astro dev` — the catch
        // below handles that.
        pagefind = await import('/pagefind/pagefind.js');
        await pagefind.init();
      } catch (err) {
        loadFailed = true;
        status.textContent =
          'Search index unavailable. It is generated at build time — run `npm run build`, then `npm run preview`.';
      }
      return pagefind;
    }

    function escapeHtml(value) {
      return String(value).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
      });
    }

    function renderFilters(counts) {
      var names = Object.keys(counts || {}).filter(function (name) {
        return counts[name] > 0;
      });
      if (names.length < 2) {
        // One category is not a choice. Print nothing rather than a single
        // chip that does nothing when clicked.
        filters.innerHTML = '';
        return;
      }
      names.sort();

      var chips = ['All'].concat(names).map(function (name) {
        var isAll = name === 'All';
        var on = isAll ? activeCategory === null : activeCategory === name;
        var count = isAll
          ? names.reduce(function (sum, n) { return sum + counts[n]; }, 0)
          : counts[name];
        var cls = on
          ? 'text-[11.5px] font-medium text-teal-dark bg-teal-light rounded-full px-3.5 py-1.5 cursor-pointer border border-transparent'
          : 'text-[11.5px] text-content/65 bg-surface border border-content/12 rounded-full px-3.5 py-1.5 cursor-pointer hover:border-teal transition-colors';
        return (
          '<button type="button" data-filter="' + escapeHtml(isAll ? '' : name) + '" class="' + cls + '">' +
          escapeHtml(name) + ' · ' + count +
          '</button>'
        );
      });

      filters.innerHTML = chips.join('');
      filters.querySelectorAll('[data-filter]').forEach(function (button) {
        button.addEventListener('click', function () {
          activeCategory = button.dataset.filter || null;
          run(lastQuery);
        });
      });
    }

    function render(items) {
      results.innerHTML = items
        .map(function (item) {
          // Titles and meta come from indexed page content, so escape them.
          // Excerpts are Pagefind-generated HTML containing only <mark>, and
          // are inserted as-is.
          var meta = item.meta || {};
          var title = escapeHtml(meta.title || item.url);
          var url = encodeURI(item.url);
          var head = '';
          if (meta.category || meta.date) {
            head =
              '<div class="flex items-center gap-2.5 mb-2">' +
              (meta.category
                ? '<span class="text-[10.5px] font-semibold text-accent uppercase tracking-[0.08em]">' + escapeHtml(meta.category) + '</span>'
                : '') +
              (meta.date
                ? '<span class="text-[11.5px] text-content/45">' + escapeHtml(meta.date) + '</span>'
                : '') +
              '</div>';
          }
          return (
            '<a href="' + url + '" class="block bg-surface border border-content/10 rounded-xl p-[22px] no-underline transition-[transform,border-color] duration-200 hover:-translate-y-0.5 hover:border-teal">' +
            head +
            '<h2 class="text-[22px] font-display font-bold text-content leading-tight mb-2">' + title + '</h2>' +
            '<p class="text-[14.5px] leading-relaxed text-content/70">' + item.excerpt + '</p>' +
            '</a>'
          );
        })
        .join('');
    }

    function reset() {
      results.innerHTML = '';
      filters.innerHTML = '';
      status.textContent = '';
      empty.classList.add('hidden');
      idle.classList.remove('hidden');
      activeCategory = null;
    }

    async function run(query) {
      var trimmed = (query || '').trim();
      lastQuery = trimmed;
      if (!trimmed) return reset();

      var pf = await ensurePagefind();
      if (!pf) return;

      idle.classList.add('hidden');
      status.textContent = 'Searching…';

      var started = performance.now();
      var options = activeCategory ? { filters: { category: [activeCategory] } } : {};
      var search = await pf.search(trimmed, options);
      var items = await Promise.all(
        search.results.slice(0, 20).map(function (r) { return r.data(); })
      );
      var elapsed = Math.max(1, Math.round(performance.now() - started));

      // totalFilters counts every category matching the query regardless of the
      // active filter, so the chips keep their counts after one is selected.
      renderFilters(
        (search.totalFilters && search.totalFilters.category) ||
        (search.filters && search.filters.category)
      );

      if (items.length === 0) {
        results.innerHTML = '';
        status.textContent = 'No results for “' + trimmed + '”.';
        empty.classList.remove('hidden');
        return;
      }

      empty.classList.add('hidden');
      status.textContent =
        items.length + ' result' + (items.length === 1 ? '' : 's') +
        ' for “' + trimmed + '” · ' + elapsed + 'ms · in-browser';
      render(items);
    }

    var debounce;
    input.addEventListener('input', function () {
      clearTimeout(debounce);
      activeCategory = null;
      debounce = setTimeout(function () { run(input.value); }, 180);
    });

    idle.querySelectorAll('[data-suggestion]').forEach(function (button) {
      button.addEventListener('click', function () {
        input.value = button.dataset.suggestion;
        input.focus();
        run(input.value);
      });
    });

    // Support deep links like /search?q=rice
    var initial = new URLSearchParams(window.location.search).get('q');
    if (initial) {
      input.value = initial;
      run(initial);
    }
  })();
</script>
