---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import { getCollection } from 'astro:content';
import { NEWSLETTER_NAME } from '../../consts';

// Newest first. `sentAt` is required by the schema, so unlike the explainers
// index this is a plain reverse-chronological sort with no undated fallback.
const issues = (await getCollection('newsletter')).sort(
  (a, b) => b.data.sentAt.getTime() - a.data.sentAt.getTime()
);

const latest = issues[0];

const issueDate = (date: Date) =>
  new Intl.DateTimeFormat('en-PH', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(date);
---
<Layout
  title="Newsletter"
  description="Philippine politics and public money, explained. Subscribe, or read every past issue free in the archive."
>
  <Header />
  <main class="max-w-[1200px] mx-auto px-6 sm:px-10 py-11 sm:py-13">
    <div
      class:list={[
        'mb-14',
        latest
          ? 'grid gap-10 lg:grid-cols-[1.05fr_0.95fr] items-start'
          : 'flex flex-col items-center text-center',
      ]}
    >
      <div class:list={[!latest && 'flex flex-col items-center']}>
        {NEWSLETTER_NAME !== 'Newsletter' && (
          <p class="text-[11px] font-semibold text-accent uppercase tracking-[0.09em] mb-4">Newsletter</p>
        )}
        <h1 class="text-4xl sm:text-[52px] font-display font-bold text-content leading-none tracking-[-0.025em] mb-4.5">
          Be updated on the latest issues!
        </h1>
        <div class="h-[3px] w-14 bg-teal mb-6"></div>
        <p class="max-w-[520px] text-lg leading-[1.65] text-content/75 mb-6">
          What happened, and why it matters. Every issue is archived here in full, free,
          and without a signup wall — the email is a convenience, not a paywall.
        </p>

        <NewsletterSignup variant="hero" showHeading={false} />
      </div>

      {/*
        The design put a fully written "Issue 001" here as a sample. That is
        exactly the invented-news-content the standing rule in CLAUDE.md
        forbids, and a mocked-up issue on the page that asks for an address is
        the worst possible place to put fiction. So this slot shows the real
        latest issue once one has been sent, and stays out of the layout
        entirely until then — the hero centers itself on the page rather than
        leaving a placeholder card standing in for one.
      */}
      {latest && (
        <a
          href={`/newsletter/${latest.id}`}
          class="block bg-surface border border-content/10 rounded-2xl overflow-hidden no-underline transition-[transform,border-color] duration-200 hover:-translate-y-0.5 hover:border-teal"
        >
          <div class="px-5 py-3.5 border-b border-content/10 flex items-center gap-2.5">
            <span class="text-[11.5px] font-mono text-content/45">Latest issue</span>
            <span class="ml-auto text-[11.5px] text-content/45">
              <time datetime={latest.data.sentAt.toISOString()}>{issueDate(latest.data.sentAt)}</time>
            </span>
          </div>
          <div class="px-7 py-6">
            <div class="text-lg font-display font-black tracking-[-0.045em] text-content leading-none">VANTAGE</div>
            <div class="h-[2.5px] w-9 bg-teal mt-1.5 mb-5"></div>
            {latest.data.issue !== undefined && (
              <p class="text-[10.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-2">
                Issue {latest.data.issue}
              </p>
            )}
            <h2 class="text-[26px] font-display font-bold text-content leading-tight mb-3.5">{latest.data.title}</h2>
            <p class="text-[15px] leading-[1.65] text-content/75 mb-4.5">{latest.data.description}</p>
            {latest.data.items.length > 1 && (
              <div class="flex flex-col gap-2.5 pt-4 border-t border-content/10">
                <p class="text-[10.5px] font-semibold text-content/50 uppercase tracking-[0.09em]">Also in this issue</p>
                {latest.data.items.slice(1, 3).map((item) => (
                  <span class="text-sm leading-snug text-content/72">{item.heading}</span>
                ))}
              </div>
            )}
          </div>
        </a>
      )}
    </div>

    {/*
      The design had a "Weekly, Sunday" card here. Left out on purpose: a
      public cadence promise costs real trust the first week it slips and buys
      very little at signup, which is the same reason NEWSLETTER_BLURB in
      consts.ts carries no rhythm claim. Add one here and there once the
      publication has actually kept one.
    */}
    <div class="grid gap-5 sm:grid-cols-2 mb-14">
      <div class="bg-surface border border-content/10 rounded-2xl p-6 v-rise">
        <p class="text-[10.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-2.5">What's in it</p>
        <h3 class="text-[22px] font-display font-bold text-content leading-tight mb-2">
          One explainer, and the numbers
        </h3>
        <p class="text-[14.5px] leading-relaxed text-content/70">
          The long-form piece in short, plus the figures worth keeping — each one carrying
          the document it came from.
        </p>
      </div>
      <div class="bg-surface border border-content/10 rounded-2xl p-6 v-rise">
        <p class="text-[10.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-2.5">Where it lives</p>
        <h3 class="text-[22px] font-display font-bold text-content leading-tight mb-2">
          Archived here, in full
        </h3>
        <p class="text-[14.5px] leading-relaxed text-content/70">
          Every issue is republished on this site as a real page — indexed, searchable, and
          readable without an address. The email is the convenience, not the record.
        </p>
      </div>
    </div>

    <section>
      <div class="flex items-baseline justify-between pb-4 border-b border-content/15 mb-5">
        <h2 class="text-[11.5px] font-semibold text-accent uppercase tracking-[0.09em]">Past issues</h2>
        {issues.length > 0 && (
          <span class="text-xs font-mono text-content/40">
            {issues.length} {issues.length === 1 ? 'issue' : 'issues'}
          </span>
        )}
      </div>

      {issues.length === 0 ? (
        <div class="bg-surface border border-dashed border-content/20 rounded-2xl p-10 text-center">
          <p class="text-[22px] font-display font-bold text-content mb-2">Nothing archived yet</p>
          <p class="mx-auto max-w-[480px] text-[15px] leading-[1.65] text-content/65">
            The first issue will be posted here in full the day it goes out. In the
            meantime, the{' '}
            <a href="/explained" class="text-accent underline underline-offset-2">explainers</a>{' '}
            are where the long-form work lives.
          </p>
        </div>
      ) : (
        <ul>
          {issues.map((issue) => (
            <li class="border-b border-content/10">
              <a
                href={`/newsletter/${issue.id}`}
                class="group flex flex-col gap-1 py-5 no-underline"
              >
                <span class="text-[12.5px] text-content/45">
                  {issue.data.issue !== undefined && (
                    <>Issue {issue.data.issue} · </>
                  )}
                  <time datetime={issue.data.sentAt.toISOString()}>
                    {issueDate(issue.data.sentAt)}
                  </time>
                </span>
                <span class="text-xl font-display font-bold text-content leading-snug group-hover:text-accent transition-colors">
                  {issue.data.title}
                </span>
                <span class="text-[15px] leading-relaxed text-content/60">
                  {issue.data.description}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>
  </main>
</Layout>
