---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import FactPost from '../../components/FactPost.astro';
import { getCollection } from 'astro:content';
import { categorySlug } from '../../utils';
import type { GetStaticPaths } from 'astro';

// NOTE: the posts collection has no date field, so `order` is the only real
// sequencing signal available. Ascending `order` matches the feed, where
// order 1 sits at the top — i.e. newest first. If true reverse-chronological
// sorting is wanted, posts need a `date` field added to the schema; that's a
// content-model decision, not something to infer here.
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = (await getCollection('posts')).sort(
    (a, b) => a.data.order - b.data.order
  );
  return paginate(posts, { pageSize: 10 });
};

const { page } = Astro.props;

// Category chips are derived from what the posts actually carry, so they stay
// correct as content is added without a second list to maintain.
const allPosts = await getCollection('posts');
const categories = [...new Set(allPosts.map((p) => p.data.category))].sort();

const pageLabel = page.currentPage > 1 ? ` (page ${page.currentPage})` : '';
---
<Layout
  title={`Archive${pageLabel}`}
  description="Every Vantage post, newest first."
>
  <Header />
  <main class="max-w-3xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-3">Archive</p>
    <h1 class="text-3xl sm:text-4xl font-display font-bold text-paper leading-tight mb-4">
      Everything we've published
    </h1>
    <p class="text-lg leading-relaxed text-paper/70 mb-8 max-w-xl">
      The full run of posts, newest first. Browse by category, or{" "}
      <a href="/search" class="text-teal-light underline underline-offset-2 hover:text-paper transition-colors">search the archive</a>.
    </p>
    <p class="text-sm text-paper/50 mb-8">
      Looking for the long reads? See the{" "}
      <a href="/explained" class="text-teal-light underline underline-offset-2 hover:text-paper transition-colors">long-form explainers</a>.
    </p>

    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {categories.map((category) => (
          <a
            href={`/category/${categorySlug(category)}`}
            class="text-[11px] font-semibold uppercase tracking-[0.08em] text-teal-light bg-ink border border-paper/15 rounded-full px-3 py-1.5 hover:border-teal transition-colors"
          >{category}</a>
        ))}
      </div>
    )}

    <div class="grid gap-4">
      {page.data.map((post) => (
        <FactPost
          category={post.data.category}
          headline={post.data.headline}
          highlight={post.data.highlight}
        />
      ))}
    </div>

    {(page.url.prev || page.url.next) && (
      <nav class="flex items-center justify-between gap-4 border-t border-paper/10 mt-10 pt-6" aria-label="Pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-sm font-medium text-teal-light hover:text-paper transition-colors">← Newer</a>
        ) : <span></span>}
        <span class="text-xs text-paper/50">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="text-sm font-medium text-teal-light hover:text-paper transition-colors">Older →</a>
        ) : <span></span>}
      </nav>
    )}
  </main>
</Layout>
