---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import ExplainerCard from '../../components/ExplainerCard.astro';
import { getCollection } from 'astro:content';
import { categorySlug, sortExplainers } from '../../utils';
import type { GetStaticPaths } from 'astro';

// Reads from `explainers` rather than `posts` — see the note in index.astro.
// Ordering is newest-first by `publishedAt`, with undated entries falling to
// the end alphabetically; sortExplainers owns that rule so the feed, archive
// and category pages can't disagree about what "newest" means.
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const explainers = sortExplainers(await getCollection('explainers'));
  return paginate(explainers, { pageSize: 10 });
};

const { page } = Astro.props;

// Category chips are derived from what the explainers actually carry, so they
// stay correct as content is added without a second list to maintain.
const all = await getCollection('explainers');
const categories = [...new Set(all.map((e) => e.data.category))].sort();

const pageLabel = page.currentPage > 1 ? ` (page ${page.currentPage})` : '';
---
<Layout
  title={`Archive${pageLabel}`}
  description="Every Vantage article, newest first."
>
  <Header />
  <main class="max-w-5xl mx-auto px-6 py-12 sm:py-16">
    <p class="text-[11.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-3">Archive</p>
    <h1 class="text-3xl sm:text-4xl font-display font-bold text-content leading-tight mb-4">
      Everything we've published
    </h1>
    <p class="text-lg leading-relaxed text-content/70 mb-8 max-w-xl">
      The full run, newest first. Browse by category, or{" "}
      <a href="/search" class="text-accent underline underline-offset-2 hover:text-content transition-colors">search the archive</a>.
    </p>

    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-8">
        {categories.map((category) => (
          <a
            href={`/category/${categorySlug(category)}`}
            class="text-[11px] font-semibold uppercase tracking-[0.08em] text-accent bg-surface border border-content/15 rounded-full px-3 py-1.5 hover:border-teal transition-colors"
          >{category}</a>
        ))}
      </div>
    )}

    <div class="grid gap-4 sm:grid-cols-2">
      {page.data.map((entry) => (
        <ExplainerCard
          slug={entry.id}
          category={entry.data.category}
          title={entry.data.title}
          description={entry.data.description}
          image={entry.data.image}
          publishedAt={entry.data.publishedAt}
        />
      ))}
    </div>

    {(page.url.prev || page.url.next) && (
      <nav class="flex items-center justify-between gap-4 border-t border-content/10 mt-10 pt-6" aria-label="Pagination">
        {page.url.prev ? (
          <a href={page.url.prev} class="text-sm font-medium text-accent hover:text-content transition-colors">← Newer</a>
        ) : <span></span>}
        <span class="text-xs text-content/50">Page {page.currentPage} of {page.lastPage}</span>
        {page.url.next ? (
          <a href={page.url.next} class="text-sm font-medium text-accent hover:text-content transition-colors">Older →</a>
        ) : <span></span>}
      </nav>
    )}
  </main>
</Layout>
