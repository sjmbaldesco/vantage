---
import { NEWSLETTER_BLURB, NEWSLETTER_NAME } from '../consts';

// The sign-up block: our markup, our tokens, no third-party script anywhere on
// the site. The form posts to `/api/subscribe`, the one server-rendered route,
// which talks to beehiiv with a key that never reaches the browser.
//
// It works without JavaScript. A native form POST returns a 303 back to the
// page with ?subscribed=1 or ?error=1, and the block reads that on render. The
// inline script is an enhancement on top: it intercepts the submit, posts the
// same data as JSON, and swaps the message in place so the reader never leaves
// the page. If the script fails to load, the form still works.

interface Props {
  variant?: 'full' | 'compact';
  // Set false where the surrounding page already names the newsletter — the
  // /newsletter landing page carries it as the <h1>, so the block repeating it
  // as an <h2> two lines later is noise, not hierarchy.
  showHeading?: boolean;
}

const { variant = 'full', showHeading = true } = Astro.props;

// While the newsletter has no sub-brand, the heading is the word "Newsletter"
// itself, so an eyebrow reading "Newsletter" above it would print the same word
// twice. Name it something and the label earns its place again.
const showEyebrow = NEWSLETTER_NAME !== 'Newsletter';

// The no-JS outcome, read back off the query string the endpoint redirected to.
const params = Astro.url.searchParams;
const initialState = params.has('subscribed')
  ? 'ok'
  : params.has('error')
    ? 'error'
    : null;

const OK_MESSAGE =
  'Almost there — check your inbox and confirm to finish subscribing.';
const ERROR_MESSAGE = "That didn't go through. Check the address and try again.";

// Sends the reader back to the page they subscribed from rather than always to
// /newsletter, so the footer form doesn't teleport people mid-article.
const action = `/api/subscribe?from=${encodeURIComponent(Astro.url.pathname)}`;

const isCompact = variant === 'compact';
---
{variant === 'full' && (
  <section class="bg-ink border border-paper/10 rounded-xl px-6 py-7 sm:px-8 sm:py-9" data-pagefind-ignore>
    {showHeading && showEyebrow && (
      <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-3">
        Newsletter
      </p>
    )}
    {showHeading && (
      <h2 class="text-2xl sm:text-3xl font-display font-bold text-paper leading-tight mb-3">
        {NEWSLETTER_NAME}
      </h2>
    )}
    <p class="text-base leading-relaxed text-paper/70 mb-6 max-w-md">
      {NEWSLETTER_BLURB}
    </p>

    <form
      class="vantage-subscribe max-w-md"
      method="POST"
      action={action}
      data-state={initialState}
    >
      <div class="flex flex-col sm:flex-row gap-2">
        <label class="sr-only" for="vs-email-full">Email address</label>
        <input
          id="vs-email-full"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="flex-1 min-w-0 rounded-lg bg-ground border border-paper/15 px-3.5 py-2.5 text-[15px] text-paper placeholder:text-paper/35 focus:outline-none focus:border-teal-light transition-colors"
        />
        {/* Hidden from humans and from screen readers; bots fill it in anyway. */}
        <div class="hidden" aria-hidden="true">
          <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-teal-light text-teal-dark font-medium text-[15px] px-5 py-2.5 hover:bg-paper transition-colors focus:outline-none focus:ring-2 focus:ring-teal-light focus:ring-offset-2 focus:ring-offset-ink"
        >
          Subscribe
        </button>
      </div>

      <p
        class="vantage-subscribe-message text-[13px] leading-relaxed mt-3"
        role="status"
        aria-live="polite"
        data-ok={OK_MESSAGE}
        data-error={ERROR_MESSAGE}
      >
        {initialState === 'ok' && <span class="text-teal-light">{OK_MESSAGE}</span>}
        {initialState === 'error' && <span class="text-paper/70">{ERROR_MESSAGE}</span>}
      </p>
    </form>

    <p class="text-[12.5px] leading-relaxed text-paper/40 mt-3 max-w-md">
      You'll get one email asking you to confirm, and nothing after that until
      you do. Your address is used to send the newsletter and nothing else, and
      every issue carries a one-click unsubscribe.
    </p>
  </section>
)}

{isCompact && (
  <div data-pagefind-ignore>
    <p class="text-[11.5px] font-semibold text-teal-light uppercase tracking-[0.09em] mb-2">
      {NEWSLETTER_NAME}
    </p>
    <p class="text-[12.5px] leading-relaxed text-paper/60 mb-3 max-w-[340px]">
      {NEWSLETTER_BLURB}
    </p>

    <form
      class="vantage-subscribe max-w-[340px]"
      method="POST"
      action={action}
      data-state={initialState}
    >
      <div class="flex gap-2">
        <label class="sr-only" for="vs-email-compact">Email address</label>
        <input
          id="vs-email-compact"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          class="flex-1 min-w-0 rounded-lg bg-ground border border-paper/15 px-3 py-2 text-[14px] text-paper placeholder:text-paper/35 focus:outline-none focus:border-teal-light transition-colors"
        />
        <div class="hidden" aria-hidden="true">
          <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <button
          type="submit"
          class="shrink-0 rounded-lg bg-teal-light text-teal-dark font-medium text-[14px] px-4 py-2 hover:bg-paper transition-colors focus:outline-none focus:ring-2 focus:ring-teal-light focus:ring-offset-2 focus:ring-offset-ink"
        >
          Subscribe
        </button>
      </div>

      <p
        class="vantage-subscribe-message text-[12.5px] leading-relaxed mt-2"
        role="status"
        aria-live="polite"
        data-ok={OK_MESSAGE}
        data-error={ERROR_MESSAGE}
      >
        {initialState === 'ok' && <span class="text-teal-light">{OK_MESSAGE}</span>}
        {initialState === 'error' && <span class="text-paper/70">{ERROR_MESSAGE}</span>}
      </p>
    </form>
  </div>
)}

<style>
  /* Tailwind's sr-only, written out so the label works even if the utility is
     ever purged from a build that has no other use for it. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // Progressive enhancement. Without this the form still submits natively and
  // the endpoint redirects back with the outcome in the query string.
  document.querySelectorAll<HTMLFormElement>('form.vantage-subscribe').forEach((form) => {
    const message = form.querySelector<HTMLElement>('.vantage-subscribe-message');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    if (!message || !button || !input) return;

    const originalLabel = button.textContent ?? 'Subscribe';

    const show = (text: string, ok: boolean) => {
      message.innerHTML = '';
      const span = document.createElement('span');
      span.className = ok ? 'text-teal-light' : 'text-paper/70';
      span.textContent = text;
      message.appendChild(span);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      button.disabled = true;
      button.textContent = 'Subscribing…';
      message.innerHTML = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            email: input.value,
            company: (form.querySelector('input[name="company"]') as HTMLInputElement | null)?.value ?? '',
          }),
        });

        const result = await response.json().catch(() => null);
        const ok = Boolean(result?.ok);
        show(result?.message ?? (message.dataset.error as string), ok);
        if (ok) form.reset();
      } catch {
        show(message.dataset.error as string, false);
      } finally {
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
  });
</script>
