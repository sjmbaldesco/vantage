---
import { NEWSLETTER_BLURB, NEWSLETTER_NAME } from '../consts';

// The sign-up block: our markup, our tokens, no third-party script anywhere on
// the site. The form posts to `/api/subscribe`, the one server-rendered route,
// which talks to beehiiv with a key that never reaches the browser.
//
// It works without JavaScript. A native form POST returns a 303 back to the
// page with ?subscribed=1 or ?error=1, and the block reads that on render. The
// inline script is an enhancement on top: it intercepts the submit, posts the
// same data as JSON, and swaps the message in place so the reader never leaves
// the page. If the script fails to load, the form still works.
//
// Four variants, one form. They differ only in size and in whether they sit on
// the page ground or carry their own:
//
//   hero    — the /newsletter landing block. Largest, full-width field.
//   full    — a standalone card anywhere else.
//   compact — the footer strip.
//   panel   — the teal-dark box at the foot of the home page's fact column.
//             The only variant that brings its own ground, which is why it
//             uses the fixed brand colours rather than the semantic tokens.

interface Props {
  variant?: 'hero' | 'full' | 'compact' | 'panel';
  // Set false where the surrounding page already names the newsletter — the
  // /newsletter landing page carries it as the <h1>, so the block repeating it
  // as an <h2> two lines later is noise, not hierarchy.
  showHeading?: boolean;
}

const { variant = 'full', showHeading = true } = Astro.props;

// While the newsletter has no sub-brand, the heading is the word "Newsletter"
// itself, so an eyebrow reading "Newsletter" above it would print the same word
// twice. Name it something and the label earns its place again.
const showEyebrow = NEWSLETTER_NAME !== 'Newsletter';

// The no-JS outcome, read back off the query string the endpoint redirected to.
const params = Astro.url.searchParams;
const initialState = params.has('subscribed')
  ? 'ok'
  : params.has('error')
    ? 'error'
    : null;

const OK_MESSAGE =
  'Almost there — check your inbox and confirm to finish subscribing.';
const ERROR_MESSAGE = "That didn't go through. Check the address and try again.";

// Sends the reader back to the page they subscribed from rather than always to
// /newsletter, so the footer form doesn't teleport people mid-article.
const action = `/api/subscribe?from=${encodeURIComponent(Astro.url.pathname)}`;

const onDark = variant === 'panel';

// A stable, unique id per variant so two blocks on one page (footer plus an
// in-page one) never collide on the label's `for`.
const fieldId = `vs-email-${variant}`;

const shell = {
  hero: '',
  full: 'bg-surface border border-content/10 rounded-2xl px-6 py-7 sm:px-8 sm:py-9',
  compact: '',
  panel: 'bg-teal-dark rounded-2xl p-5',
}[variant];

const inputClass = onDark
  ? 'flex-1 min-w-0 rounded-lg bg-paper/8 border border-teal-light/35 px-2.5 py-2 text-[13px] text-paper placeholder:text-paper/40 focus:outline-none focus:border-teal-light transition-colors'
  : variant === 'hero'
    ? 'flex-1 min-w-0 rounded-[10px] bg-surface border border-content/15 px-4 py-3.5 text-base text-content placeholder:text-content/40 focus:outline-none focus:border-teal transition-colors'
    : 'flex-1 min-w-0 rounded-lg bg-surface border border-content/15 px-3.5 py-2.5 text-[15px] text-content placeholder:text-content/40 focus:outline-none focus:border-teal transition-colors';

const buttonClass = onDark
  ? 'shrink-0 rounded-lg bg-teal-light text-teal-dark font-medium text-[13px] px-3.5 py-2 hover:bg-paper transition-colors cursor-pointer'
  : variant === 'hero'
    ? 'shrink-0 rounded-[10px] bg-accent text-ground font-medium text-base px-6 py-3.5 transition-transform duration-200 hover:-translate-y-0.5 cursor-pointer'
    : 'shrink-0 rounded-lg bg-accent text-ground font-medium text-[15px] px-5 py-2.5 transition-transform duration-200 hover:-translate-y-0.5 cursor-pointer';

const formWidth = variant === 'hero' ? 'max-w-[520px]' : onDark ? '' : 'max-w-md';
---
<div class:list={[shell, onDark && 'vs-on-dark']} data-pagefind-ignore>
  {variant === 'panel' && (
    <>
      <p class="text-[11px] font-semibold text-teal-light uppercase tracking-[0.08em] mb-1.5">Newsletter</p>
      <p class="text-[13px] leading-relaxed text-paper/80 mb-3.5">
        Be updated on the latest issues!
      </p>
    </>
  )}

  {variant === 'compact' && (
    <>
      <p class="text-[11.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-2">
        {NEWSLETTER_NAME}
      </p>
      <p class="text-[12.5px] leading-relaxed text-content/60 mb-3 max-w-[340px]">
        {NEWSLETTER_BLURB}
      </p>
    </>
  )}

  {(variant === 'full' || variant === 'hero') && (
    <>
      {showHeading && showEyebrow && (
        <p class="text-[11.5px] font-semibold text-accent uppercase tracking-[0.09em] mb-3">
          Newsletter
        </p>
      )}
      {showHeading && (
        <h2 class="text-2xl sm:text-3xl font-display font-bold text-content leading-tight mb-3">
          {NEWSLETTER_NAME}
        </h2>
      )}
      {variant === 'full' && (
        <p class="text-base leading-relaxed text-content/70 mb-6 max-w-md">
          {NEWSLETTER_BLURB}
        </p>
      )}
    </>
  )}

  <form
    class:list={['vantage-subscribe', formWidth]}
    method="POST"
    action={action}
    data-state={initialState}
  >
    <div class:list={['flex gap-2', variant === 'full' && 'flex-col sm:flex-row']}>
      <label class="sr-only" for={fieldId}>Email address</label>
      <input
        id={fieldId}
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder="you@example.com"
        class={inputClass}
      />
      {/* Hidden from humans and from screen readers; bots fill it in anyway. */}
      <div class="hidden" aria-hidden="true">
        <label>Company<input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
      </div>
      <button type="submit" class={buttonClass}>Subscribe</button>
    </div>

    <p
      class="vantage-subscribe-message text-[13px] leading-relaxed mt-2.5"
      role="status"
      aria-live="polite"
      data-ok={OK_MESSAGE}
      data-error={ERROR_MESSAGE}
    >
      {initialState === 'ok' && <span class="vs-ok">{OK_MESSAGE}</span>}
      {initialState === 'error' && <span class="vs-err">{ERROR_MESSAGE}</span>}
    </p>
  </form>

  {variant === 'full' && (
    <p class="text-[12.5px] leading-relaxed text-content/45 mt-3 max-w-md">
      You'll get one email asking you to confirm, and nothing after that until
      you do. Your address is used to send the newsletter and nothing else, and
      every issue carries a one-click unsubscribe.
    </p>
  )}
</div>

<style is:global>
  /* Outcome colours live in CSS rather than in the script's class strings so
     the panel variant — the only block with its own dark ground — can restate
     them once instead of the script having to know which variant it is in. */
  .vs-ok {
    color: var(--color-teal);
    font-weight: 500;
  }
  .vs-err {
    color: color-mix(in oklab, var(--color-content) 70%, transparent);
  }
  .vs-on-dark .vs-ok {
    color: var(--color-teal-light);
  }
  .vs-on-dark .vs-err {
    color: color-mix(in oklab, var(--color-paper) 70%, transparent);
  }
</style>

<style>
  /* Tailwind's sr-only, written out so the label works even if the utility is
     ever purged from a build that has no other use for it. */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border-width: 0;
  }
</style>

<script>
  // Progressive enhancement. Without this the form still submits natively and
  // the endpoint redirects back with the outcome in the query string.
  document.querySelectorAll<HTMLFormElement>('form.vantage-subscribe').forEach((form) => {
    const message = form.querySelector<HTMLElement>('.vantage-subscribe-message');
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    if (!message || !button || !input) return;

    const originalLabel = button.textContent ?? 'Subscribe';

    const show = (text: string, ok: boolean) => {
      message.innerHTML = '';
      const span = document.createElement('span');
      span.className = ok ? 'vs-ok' : 'vs-err';
      span.textContent = text;
      message.appendChild(span);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      button.disabled = true;
      button.textContent = 'Subscribing…';
      message.innerHTML = '';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            email: input.value,
            company: (form.querySelector('input[name="company"]') as HTMLInputElement | null)?.value ?? '',
          }),
        });

        const result = await response.json().catch(() => null);
        const ok = Boolean(result?.ok);
        show(result?.message ?? (message.dataset.error as string), ok);
        if (ok) form.reset();
      } catch {
        show(message.dataset.error as string, false);
      } finally {
        button.disabled = false;
        button.textContent = originalLabel;
      }
    });
  });
</script>
