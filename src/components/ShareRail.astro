---
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;

// Plain share URLs, not platform SDKs. Both networks accept a link in a query
// string, which means no third-party script, no tracking pixel, and no
// dependency on either company's embed staying alive — the same reasoning that
// took the beehiiv embed off the newsletter form.
const facebook = `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(url)}`;
const x = `https://twitter.com/intent/tweet?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;

const chip =
  'inline-flex items-center justify-center h-9 rounded-[9px] border border-content/15 bg-surface text-accent no-underline transition-colors hover:border-teal';
---
<div data-pagefind-ignore>
  <p class="text-[10.5px] font-semibold text-content/50 uppercase tracking-[0.09em] mb-2.5">Share</p>
  <div class="flex gap-2">
    <a href={facebook} target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" class:list={[chip, 'w-9']}>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14c-.33-.04-1.56-.14-2.86-.14C11.93 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5z" />
      </svg>
    </a>
    <a href={x} target="_blank" rel="noopener noreferrer" aria-label="Share on X" class:list={[chip, 'w-9']}>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M18.24 2.25h3.31l-7.23 8.26 8.5 11.24h-6.66l-5.21-6.82-5.97 6.82H1.68l7.73-8.84L1.25 2.25h6.83l4.71 6.23zm-1.16 17.52h1.83L7.08 4.13H5.12z" />
      </svg>
    </a>
    {/* Hidden until the script confirms the clipboard API is there. A button
        that silently does nothing is worse than one that was never offered. */}
    <button
      type="button"
      hidden
      data-copy-link
      data-url={url}
      class:list={[chip, 'px-3 text-xs font-medium cursor-pointer']}
    >Copy link</button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    if (!navigator.clipboard) return;
    button.hidden = false;

    const original = button.textContent ?? 'Copy link';
    let reset: ReturnType<typeof setTimeout>;

    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.url ?? window.location.href);
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Press ⌘C';
      }
      clearTimeout(reset);
      reset = setTimeout(() => {
        button.textContent = original;
      }, 2000);
    });
  });
</script>
