---
import { NAV_LINKS } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  // Article pages put a reading-progress rail above the bar and print what
  // you are reading in the middle of it. Both are off everywhere else — a
  // progress bar on a listing page measures nothing a reader cares about.
  progress?: boolean;
  nowReading?: string;
}
const { progress = false, nowReading } = Astro.props;

const path = Astro.url.pathname;
// "/" matches only itself; section roots also match their child pages so an
// explainer detail page still marks its section as current.
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

// NOTE: the query string is deliberately NOT read here. Pages are prerendered
// at build time, so Astro.url.searchParams is always empty in the output —
// prefilling the box has to happen client-side (see the script below).
---
{/*
  data-pagefind-ignore: nav and search chrome appear on every page and would
  otherwise match every query.

  The search field is a plain GET form pointing at /search, so it works with no
  JavaScript at all — the browser builds /search?q=… and the results page reads
  it. The mobile menu is a <details> for the same reason: it opens without JS
  and gets native keyboard/ARIA behaviour. The script below only adds
  Escape-to-close and click-outside-to-close.

  The bar is sticky and translucent. Everything that moves is CSS: the padding
  and wordmark scrub down over the first 160px of scroll, the teal rule draws
  across the foot of the bar over the same range, and the wordmark, search and
  each nav item rise in once on a 60ms stagger. See the motion section of
  global.css for why the scrubbed pieces sit behind an @supports guard.
*/}
<div class="sticky top-0 z-40" data-pagefind-ignore>
  {progress && (
    <div class="h-[3px] bg-content/10">
      <div class="h-[3px] bg-teal origin-left v-bar"></div>
    </div>
  )}

  <header
    class="relative bg-surface/92 backdrop-blur-md border-b border-content/10 px-6 py-5 sm:px-10 sm:py-[22px] v-compact"
  >
    <div class="mx-auto max-w-[1200px] flex flex-wrap items-center justify-between gap-x-8 gap-y-4">
      <a href="/" class="inline-block shrink-0 v-nav-in">
        {/* Heavy (900) is the heaviest cut in the free Mont release, so weight is
            already maxed — the heft comes from size and tight tracking. */}
        <div class="text-[30px] font-display font-black tracking-[-0.045em] text-content leading-none v-shrink">VANTAGE</div>
        <div class="h-[3px] w-14 bg-teal mt-[7px]"></div>
      </a>

      {nowReading && (
        <span class="hidden lg:block flex-1 text-center text-[13px] font-medium text-content/55 truncate">
          {nowReading}
        </span>
      )}

      {!nowReading && (
        <form
          action="/search"
          method="get"
          role="search"
          class="order-last w-full sm:order-none sm:w-auto sm:flex-1 sm:max-w-xs sm:focus-within:max-w-[440px] transition-[max-width] duration-300 v-nav-in [animation-delay:60ms]"
        >
          <label for="nav-search" class="sr-only">Search Vantage</label>
          <div class="relative">
            <svg
              class="absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none text-content/45"
              width="15"
              height="15"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <circle cx="11" cy="11" r="7" />
              <line x1="16.5" y1="16.5" x2="21" y2="21" />
            </svg>
            <input
              id="nav-search"
              type="search"
              name="q"
              autocomplete="off"
              placeholder="Search…"
              class="w-full bg-ground border border-content/12 rounded-lg pl-9 pr-3 py-2 text-sm text-content placeholder:text-content/40 focus:border-teal focus:bg-surface focus:outline-none transition-colors"
            />
          </div>
        </form>
      )}

      <nav class="hidden sm:flex items-center gap-x-6 text-sm shrink-0">
        {NAV_LINKS.map((link, index) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            style={`animation-delay:${120 + index * 60}ms`}
            class:list={[
              'v-nav-in v-rule-link pb-[5px]',
              isActive(link.href) ? 'text-content font-medium is-current' : 'text-accent',
            ]}
          >{link.label}</a>
        ))}
        <div class="v-nav-in [animation-delay:300ms]">
          <ThemeToggle />
        </div>
      </nav>

      <div class="flex items-center gap-2.5 sm:hidden">
        <ThemeToggle />

        <details class="relative" data-mobile-nav>
          <summary
            class="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none inline-flex items-center justify-center w-9 h-9 rounded-lg border border-content/15 text-accent transition-colors"
            aria-label="Toggle navigation menu"
          >
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <line x1="3" y1="6" x2="21" y2="6" />
              <line x1="3" y1="12" x2="21" y2="12" />
              <line x1="3" y1="18" x2="21" y2="18" />
            </svg>
          </summary>

          <nav
            class="absolute right-0 top-full z-50 mt-3 w-52 flex flex-col p-2 bg-surface border border-content/12 rounded-xl shadow-xl shadow-black/10"
          >
            {NAV_LINKS.map((link) => (
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class:list={[
                  'rounded-lg px-3 py-2.5 text-sm transition-colors',
                  isActive(link.href)
                    ? 'bg-ground text-content font-medium'
                    : 'text-accent hover:bg-ground',
                ]}
              >{link.label}</a>
            ))}
          </nav>
        </details>
      </div>
    </div>

    {/* Draws across the foot of the bar as the page scrolls. Purely decorative
        — the border-b above already separates the bar from the page. */}
    <div class="absolute inset-x-0 bottom-0 h-[2px] bg-teal origin-left v-teal-rule"></div>
  </header>
</div>

<style>
  /* A background-size transition, not text-decoration — the same mechanic the
     highlight device uses, so the nav and the signature move alike. The current
     page keeps its rule permanently. */
  .v-rule-link {
    text-decoration: none;
    background-image: linear-gradient(var(--color-teal), var(--color-teal));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size 0.25s cubic-bezier(0.22, 0.8, 0.2, 1);
  }
  .v-rule-link:hover,
  .v-rule-link.is-current {
    background-size: 100% 2px;
  }
</style>

<script>
  // Pages are prerendered, so the ?q= value can only be read in the browser.
  // Mirroring it back into the box means refining a search doesn't mean
  // retyping the query.
  const navSearch = document.getElementById('nav-search') as HTMLInputElement | null;
  const activeQuery = new URLSearchParams(window.location.search).get('q');
  if (navSearch && activeQuery && !navSearch.value) navSearch.value = activeQuery;

  // Progressive enhancement only — the <details> element already opens and
  // closes on its own without any of this.
  function closeAll() {
    document
      .querySelectorAll<HTMLDetailsElement>('details[data-mobile-nav][open]')
      .forEach((menu) => {
        menu.open = false;
      });
  }

  document.addEventListener('click', (event) => {
    document
      .querySelectorAll<HTMLDetailsElement>('details[data-mobile-nav][open]')
      .forEach((menu) => {
        if (!menu.contains(event.target as Node)) menu.open = false;
      });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
</script>
