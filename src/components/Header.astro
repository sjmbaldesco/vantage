---
import { NAV_LINKS } from '../consts';

const path = Astro.url.pathname;
// "/" matches only itself; section roots also match their child pages so an
// explainer detail page still marks "Explained" as current.
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);
---
{/*
  data-pagefind-ignore: nav text appears on every page and would otherwise
  match every search query.

  The mobile menu is a <details> rather than a JS-driven panel so it still
  opens without JavaScript and gets native keyboard/ARIA behaviour for free.
  The script below only adds the niceties (Escape, click-outside).
*/}
<header class="bg-ink" data-pagefind-ignore>
  <div class="mx-auto max-w-3xl px-6 py-6 flex items-start justify-between gap-4">
    <a href="/" class="inline-block shrink-0">
      <div class="text-2xl font-display font-bold tracking-tight text-paper leading-none">VANTAGE</div>
      <div class="h-[3px] w-14 bg-teal mt-2"></div>
    </a>

    <nav class="hidden sm:flex flex-wrap justify-end gap-x-6 gap-y-1 text-sm pt-1">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          aria-current={isActive(link.href) ? 'page' : undefined}
          class:list={[
            'hover:text-paper transition-colors',
            isActive(link.href) ? 'text-paper' : 'text-teal-light',
          ]}
        >{link.label}</a>
      ))}
    </nav>

    <details class="relative sm:hidden" data-mobile-nav>
      <summary
        class="list-none [&::-webkit-details-marker]:hidden cursor-pointer select-none inline-flex items-center gap-2 -mr-2 px-2 py-1.5 rounded-md text-teal-light hover:text-paper transition-colors"
        aria-label="Toggle navigation menu"
      >
        <span class="text-sm font-medium">Menu</span>
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </summary>

      <nav
        class="absolute right-0 top-full z-50 mt-3 w-52 flex flex-col p-2 bg-ink border border-paper/15 rounded-xl shadow-xl shadow-black/40"
      >
        {NAV_LINKS.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-lg px-3 py-2.5 text-sm transition-colors',
              isActive(link.href)
                ? 'bg-paper/10 text-paper font-medium'
                : 'text-teal-light hover:bg-paper/5 hover:text-paper',
            ]}
          >{link.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  // Progressive enhancement only — the <details> element already opens and
  // closes on its own without any of this.
  function closeAll() {
    document
      .querySelectorAll<HTMLDetailsElement>('details[data-mobile-nav][open]')
      .forEach((menu) => {
        menu.open = false;
      });
  }

  document.addEventListener('click', (event) => {
    document
      .querySelectorAll<HTMLDetailsElement>('details[data-mobile-nav][open]')
      .forEach((menu) => {
        if (!menu.contains(event.target as Node)) menu.open = false;
      });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAll();
  });
</script>
